<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Add Expense" android:textSize="24sp" android:textStyle="bold"
            android:textColor="@color/text" android:layout_marginBottom="24dp"/>

        <!-- Amount -->
        <TextView style="@style/FieldLabel" android:text="AMOUNT (₹)"/>
        <EditText android:id="@+id/etAmount"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input" android:paddingHorizontal="14dp"
            android:textColor="@color/text" android:textColorHint="@color/muted"
            android:hint="0.00" android:inputType="numberDecimal"
            android:textSize="18sp" android:layout_marginBottom="16dp"/>

        <!-- Description -->
        <TextView style="@style/FieldLabel" android:text="DESCRIPTION"/>
        <EditText android:id="@+id/etDescription"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input" android:paddingHorizontal="14dp"
            android:textColor="@color/text" android:textColorHint="@color/muted"
            android:hint="What was this for?" android:inputType="text"
            android:layout_marginBottom="16dp"/>

        <!-- Location badge -->
        <TextView style="@style/FieldLabel" android:text="LOCATION"/>
        <TextView android:id="@+id/tvLocation"
            android:layout_width="match_parent" android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp" android:gravity="center_vertical"
            android:text="No location" android:textColor="@color/muted"
            android:textSize="13sp" android:layout_marginBottom="16dp"/>

        <!-- Group selector -->
        <TextView style="@style/FieldLabel" android:text="GROUP (OPTIONAL)"/>
        <Spinner android:id="@+id/spGroup"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:layout_marginBottom="16dp"/>

        <!-- Split type radio group -->
        <RadioGroup android:id="@+id/rgSplitType"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp"
            android:visibility="gone">

            <RadioButton android:id="@+id/rbEqual"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Equal"
                android:textColor="@color/text" android:checked="true"/>

            <RadioButton android:id="@+id/rbPercentage"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="%" android:textColor="@color/text"/>

            <RadioButton android:id="@+id/rbDutch"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="Dutch" android:textColor="@color/text"/>
        </RadioGroup>

        <!-- Dynamic split rows -->
        <LinearLayout android:id="@+id/layoutSplits"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp"
            android:visibility="gone"/>

        <!-- Buttons -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">

            <Button android:id="@+id/btnCancel"
                android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
                android:text="Cancel" android:textColor="@color/orange"
                android:background="@drawable/bg_btn_secondary"
                android:layout_marginEnd="8dp"/>

            <Button android:id="@+id/btnSave"
                android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="2"
                android:text="Save Expense" android:textStyle="bold"
                android:background="@drawable/bg_btn_primary" android:textColor="@color/white"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
