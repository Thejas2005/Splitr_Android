<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <!-- Offline banner -->
    <TextView
        android:id="@+id/tvOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📵 Offline — showing cached data"
        android:textColor="@color/orange"
        android:textSize="12sp"
        android:gravity="center"
        android:background="@color/surface2"
        android:padding="10dp"
        android:visibility="gone"
        android:elevation="4dp"/>

    <!-- Pending sync banner -->
    <TextView
        android:id="@+id/tvPendingBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/green"
        android:textSize="12sp"
        android:gravity="center"
        android:background="@color/surface2"
        android:padding="10dp"
        android:visibility="gone"
        android:elevation="4dp"
        android:layout_marginTop="38dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="72dp">

        <!-- Header -->

        <!-- Sub-tabs with expense count -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Top row: Username + Logout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvUsername"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hey there 👋"
                    android:textColor="@color/text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnLogout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="6dp"
                    android:text="Log out"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Balance cards row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Net balance card -->
                <LinearLayout
                    android:layout_width="5dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="NET"
                        android:textColor="@color/muted"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvNetBalance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="₹0"
                        android:textColor="@color/green"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- I Owe card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="I OWE"
                        android:textColor="@color/muted"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvIOwe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="₹0"
                        android:textColor="@color/red"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <!-- Count badge -->
                    <TextView
                        android:id="@+id/tvIOweCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0 people"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />
                </LinearLayout>

                <!-- Owed to me card -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="OWED"
                        android:textColor="@color/muted"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/tvOwedToMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="₹0"
                        android:textColor="@color/green"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <!-- Count badge -->
                    <TextView
                        android:id="@+id/tvOwedCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="0 people"
                        android:textColor="@color/muted"
                        android:textSize="10sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/surface2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tabExpenses"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Expenses"
                    android:textSize="13sp"
                    android:textColor="@color/blue_bright"
                    android:background="@drawable/selector_tab_bottom"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/tabIOwe"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="I Owe"
                    android:textSize="13sp"
                    android:textColor="@color/muted"
                    android:background="@drawable/selector_tab_bottom"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/tabOwed"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Owed to Me"
                    android:textSize="13sp"
                    android:textColor="@color/muted"
                    android:background="@drawable/selector_tab_bottom"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Summary bar — shown under active tab -->
            <TextView
                android:id="@+id/tvSummaryBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="11sp"
                android:textColor="@color/muted"
                android:gravity="center"
                android:padding="6dp"
                android:background="@color/bg"
                android:visibility="visible"/>
        </LinearLayout>

        <!-- Content panes -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvExpenses"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:clipToPadding="false"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvIOwe"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:clipToPadding="false"
                android:visibility="gone"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOwed"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="12dp"
                android:clipToPadding="false"
                android:visibility="gone"/>
        </FrameLayout>

    </LinearLayout>

    <!-- FAB — raised higher with larger bottom margin -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAdd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="88dp"
        app:backgroundTint="@color/blue"
        android:src="@drawable/ic_add"
        app:tint="@color/white"/>

    <!-- Bottom Navigation -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/surface"
        app:menu="@menu/bottom_nav"
        app:itemIconTint="@color/nav_icon_color"
        app:itemTextColor="@color/nav_icon_color"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
