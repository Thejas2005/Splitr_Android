<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:background="@drawable/bg_card"
    android:padding="12dp" android:layout_marginBottom="6dp">
  <TextView android:id="@+id/tvBillPersonName"
      android:layout_width="0dp" android:layout_height="wrap_content"
      android:layout_weight="1" android:textColor="@color/text" android:textSize="13sp"/>
  <TextView android:id="@+id/tvBillPersonAmt"
      android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:textColor="@color/blue_bright" android:textSize="13sp" android:textStyle="bold"/>
</LinearLayout>
