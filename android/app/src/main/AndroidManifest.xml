<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.splitr.app">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Splitr">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBd3gQ7AzQpYQQDvpGYNuD-ux-pTJr1Qlo" />

        <activity
            android:name=".activities.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.DashboardActivity"
            android:exported="false" />
        <activity android:name=".activities.MapActivity"
            android:exported="false" />
        <activity android:name=".activities.GroupActivity"
            android:exported="false" />
        <activity android:name=".activities.AddExpenseActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>