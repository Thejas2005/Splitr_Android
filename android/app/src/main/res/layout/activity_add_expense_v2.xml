<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Add Expense" android:textSize="24sp" android:textStyle="bold"
            android:textColor="@color/text" android:layout_marginBottom="20dp"/>

        <!-- Amount -->
        <TextView style="@style/FieldLabel" android:text="AMOUNT (₹)"/>
        <EditText android:id="@+id/etAmount"
            android:layout_width="match_parent" android:layout_height="52dp"
            android:background="@drawable/bg_input" android:paddingHorizontal="14dp"
            android:textColor="@color/text" android:textColorHint="@color/muted"
            android:hint="0.00" android:inputType="numberDecimal"
            android:textSize="20sp" android:layout_marginBottom="14dp"/>

        <!-- Description -->
        <TextView style="@style/FieldLabel" android:text="DESCRIPTION"/>
        <EditText android:id="@+id/etDescription"
            android:layout_width="match_parent" android:layout_height="50dp"
            android:background="@drawable/bg_input" android:paddingHorizontal="14dp"
            android:textColor="@color/text" android:textColorHint="@color/muted"
            android:hint="What's this for?" android:inputType="text"
            android:singleLine="true" android:layout_marginBottom="14dp"/>

        <!-- Location section -->
        <TextView style="@style/FieldLabel" android:text="LOCATION"/>

        <!-- Location search bar -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp"
            android:orientation="horizontal" android:background="@drawable/bg_input"
            android:gravity="center_vertical" android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="🔍" android:textSize="15sp" android:layout_marginEnd="8dp"/>

            <AutoCompleteTextView android:id="@+id/etLocationSearch"
                android:layout_width="0dp" android:layout_height="match_parent"
                android:layout_weight="1" android:background="@null"
                android:hint="Search or enter place name…"
                android:textColor="@color/text" android:textColorHint="@color/muted"
                android:textSize="14sp" android:singleLine="true"
                android:imeOptions="actionSearch" android:inputType="text"
                android:completionThreshold="1"
                android:dropDownWidth="match_parent"
                android:popupBackground="@color/surface2"/>

            <Button android:id="@+id/btnClearLocation"
                android:layout_width="24dp" android:layout_height="24dp"
                android:text="×" android:textColor="@color/muted" android:textSize="16sp"
                android:background="@null" android:padding="0dp" android:visibility="gone"/>
        </LinearLayout>

        <!-- Location action buttons -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">

            <Button android:id="@+id/btnUseCurrentLocation"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Use Current Location"
                android:textColor="@color/white" android:textSize="15dp"
                android:background="@drawable/bg_btn_secondary"
                android:layout_marginEnd="8dp" android:stateListAnimator="@null"/>

            <Button android:id="@+id/btnPickOnMap"
                android:layout_width="0dp" android:layout_height="40dp"
                android:layout_weight="1"
                android:text="Pick on Map"
                android:textColor="@color/white" android:textSize="15sp"
                android:background="@drawable/bg_btn_secondary"
                android:stateListAnimator="@null"/>
        </LinearLayout>

        <!-- Selected location display -->
        <TextView android:id="@+id/tvLocation"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_card" android:padding="10dp"
            android:textColor="@color/muted" android:textSize="12sp"
            android:text="No location selected"
            android:layout_marginBottom="18dp"/>

        <!-- Members section -->
        <TextView style="@style/FieldLabel" android:text="SPLIT WITH (OPTIONAL)"/>

        <LinearLayout android:id="@+id/llMemberChips"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginBottom="6dp">

            <AutoCompleteTextView android:id="@+id/etMemberInput"
                android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
                android:background="@drawable/bg_input" android:paddingHorizontal="12dp"
                android:textColor="@color/text" android:textColorHint="@color/muted"
                android:hint="Username or guest name..." android:textSize="14sp"
                android:singleLine="true" android:layout_marginEnd="8dp"
                android:popupBackground="@color/surface"/>

            <Button android:id="@+id/btnAddMember"
                android:layout_width="wrap_content" android:layout_height="44dp"
                android:text="Add" android:textColor="@color/white"
                android:background="@drawable/bg_button_primary"
                android:paddingHorizontal="16dp" android:stateListAnimator="@null"/>
        </LinearLayout>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Unknown names are added as guests."
            android:textColor="@color/muted" android:textSize="11sp"
            android:layout_marginBottom="14dp"/>

        <!-- Split section -->
        <LinearLayout android:id="@+id/llSplitSection"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:visibility="gone">

            <TextView style="@style/FieldLabel" android:text="SPLIT METHOD"/>

            <RadioGroup android:id="@+id/rgSplitType"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginBottom="12dp">

                <RadioButton android:id="@+id/rbEqual"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Equal"
                    android:textColor="@color/text" android:checked="true"
                    android:buttonTint="@color/blue"/>

                <RadioButton android:id="@+id/rbPercentage"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="%" android:textColor="@color/text"
                    android:buttonTint="@color/blue"/>

                <RadioButton android:id="@+id/rbDutch"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="Dutch" android:textColor="@color/text"
                    android:buttonTint="@color/blue"/>
            </RadioGroup>

            <LinearLayout android:id="@+id/llSplitRows"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:layout_marginBottom="4dp"/>

            <TextView android:id="@+id/tvSplitValidation"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="@color/muted"
                android:layout_marginBottom="10dp"/>

            <LinearLayout android:id="@+id/llBillBtn"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:visibility="gone"
                android:layout_marginBottom="10dp">
                <Button android:id="@+id/btnBillSplitter"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:text="🧾  Split by Bill Items"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_btn_secondary"
                    android:stateListAnimator="@null"/>
            </LinearLayout>

        </LinearLayout>

        <!-- Save / Cancel -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="8dp">

            <Button android:id="@+id/btnCancel"
                android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1"
                android:text="Cancel" android:textColor="@color/white"
                android:background="@drawable/bg_btn_secondary"
                android:layout_marginEnd="8dp" android:stateListAnimator="@null"/>

            <Button android:id="@+id/btnSave"
                android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="2"
                android:text="Save Expense" android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_btn_primary"
                android:stateListAnimator="@null"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>