<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp"
        android:minHeight="600dp">

        <!-- Logo -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="36dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_logo"
                android:background="@drawable/bg_logo"
                android:padding="16dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Splitr"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="@color/text"
                android:letterSpacing="-0.03"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Geo-intelligent expense splitting"
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="24dp">

            <!-- Tabs -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_tab_host"
                android:orientation="horizontal"
                android:padding="4dp"
                android:layout_marginBottom="24dp">

                <TextView
                    android:id="@+id/tabSignIn"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Sign In"
                    android:textSize="14sp"
                    android:textColor="@color/text"
                    android:background="@drawable/selector_tab"
                    android:clickable="true"
                    android:focusable="true"/>

                <TextView
                    android:id="@+id/tabRegister"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="Register"
                    android:textSize="14sp"
                    android:textColor="@color/white"
                    android:background="@drawable/selector_tab"
                    android:clickable="true"
                    android:focusable="true"/>
            </LinearLayout>

            <!-- Login Pane -->
            <LinearLayout
                android:id="@+id/paneLogin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="USERNAME" android:textSize="11sp" android:textColor="@color/muted"
                    android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/etLoginUser"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input" android:paddingHorizontal="14dp"
                    android:textColor="@color/text" android:textColorHint="@color/muted"
                    android:hint="Enter username" android:inputType="text"
                    android:layout_marginBottom="16dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PASSWORD" android:textSize="11sp" android:textColor="@color/muted"
                    android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/etLoginPass"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input" android:paddingHorizontal="14dp"
                    android:textColor="@color/text" android:textColorHint="@color/muted"
                    android:hint="Enter password" android:inputType="textPassword"
                    android:layout_marginBottom="20dp"/>

                <Button android:id="@+id/btnLogin"
                    android:layout_width="match_parent" android:layout_height="50dp"
                    android:text="Sign In" android:textSize="15sp" android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary" android:textColor="@color/white"/>
            </LinearLayout>

            <!-- Register Pane -->
            <LinearLayout
                android:id="@+id/paneRegister"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="USERNAME" android:textSize="11sp" android:textColor="@color/muted"
                    android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/etRegUser"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input" android:paddingHorizontal="14dp"
                    android:textColor="@color/text" android:textColorHint="@color/muted"
                    android:hint="Choose username" android:inputType="text"
                    android:layout_marginBottom="16dp"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="PASSWORD" android:textSize="11sp" android:textColor="@color/muted"
                    android:letterSpacing="0.1" android:layout_marginBottom="8dp"/>
                <EditText android:id="@+id/etRegPass"
                    android:layout_width="match_parent" android:layout_height="48dp"
                    android:background="@drawable/bg_input" android:paddingHorizontal="14dp"
                    android:textColor="@color/text" android:textColorHint="@color/muted"
                    android:hint="Choose password" android:inputType="textPassword"
                    android:layout_marginBottom="20dp"/>

                <Button android:id="@+id/btnRegister"
                    android:layout_width="match_parent" android:layout_height="50dp"
                    android:text="Create Account" android:textSize="15sp" android:textStyle="bold"
                    android:background="@drawable/bg_btn_primary" android:textColor="@color/white"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</ScrollView>
