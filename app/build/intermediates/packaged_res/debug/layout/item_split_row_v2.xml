<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:layout_marginBottom="10dp"
    android:gravity="center_vertical">
  <TextView android:id="@+id/tvMemberName"
      android:layout_width="0dp" android:layout_height="wrap_content"
      android:layout_weight="1" android:textColor="@color/text" android:textSize="13sp"/>
  <EditText android:id="@+id/etSplitValue"
      android:layout_width="90dp" android:layout_height="40dp"
      android:background="@drawable/bg_input" android:inputType="numberDecimal"
      android:paddingHorizontal="10dp" android:textColor="@color/text"
      android:textColorHint="@color/muted" android:textSize="13sp" android:textAlignment="textEnd"/>
  <TextView android:id="@+id/tvSplitSuffix"
      android:layout_width="24dp" android:layout_height="wrap_content"
      android:textColor="@color/muted" android:textSize="12sp"
      android:paddingStart="4dp" android:text="₹"/>
</LinearLayout>
