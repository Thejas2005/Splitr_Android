<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Expense"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text"
            android:layout_marginBottom="20dp"/>

        <!-- Amount -->
        <TextView style="@style/FieldLabel" android:text="AMOUNT (₹)"/>
        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:hint="0.00"
            android:inputType="numberDecimal"
            android:textSize="20sp"
            android:layout_marginBottom="14dp"/>

        <!-- Description -->
        <TextView style="@style/FieldLabel" android:text="DESCRIPTION"/>
        <EditText
            android:id="@+id/etDescription"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:hint="What's this for?"
            android:inputType="text"
            android:layout_marginBottom="14dp"/>

        <!-- Location -->
        <TextView style="@style/FieldLabel" android:text="LOCATION"/>
        <TextView
            android:id="@+id/tvLocation"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_input"
            android:paddingHorizontal="14dp"
            android:gravity="center_vertical"
            android:textColor="@color/muted"
            android:textSize="13sp"
            android:layout_marginBottom="18dp"/>

        <!-- Members -->
        <TextView style="@style/FieldLabel" android:text="SPLIT WITH (OPTIONAL)"/>

        <LinearLayout
            android:id="@+id/llMemberChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <AutoCompleteTextView
                android:id="@+id/etMemberInput"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_input"
                android:paddingHorizontal="12dp"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:hint="Username or guest name..."
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnAddMember"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Add"
                android:textColor="@color/white"
                android:background="@drawable/bg_button_primary"/>
        </LinearLayout>

        <!-- Split Section -->
        <LinearLayout
            android:id="@+id/llSplitSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <RadioGroup
                android:id="@+id/rgSplitType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- ✅ FIXED RADIO BUTTONS -->
                <RadioButton
                    android:id="@+id/rbEqual"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Equal"
                    android:textColor="@color/text"/>

                <RadioButton
                    android:id="@+id/rbPercentage"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="%"
                    android:textColor="@color/text"/>

                <RadioButton
                    android:id="@+id/rbDutch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dutch"
                    android:textColor="@color/text"/>

            </RadioGroup>

            <LinearLayout
                android:id="@+id/llSplitRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>

            <TextView
                android:id="@+id/tvSplitValidation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <!-- Bill Split Button -->
        <LinearLayout
            android:id="@+id/llBillBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <Button
                android:id="@+id/btnBillSplitter"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Split by Bill"
                android:textColor="@color/white"
                android:background="@drawable/bg_btn_primary"/>
        </LinearLayout>

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="Cancel"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:text="Save Expense"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>