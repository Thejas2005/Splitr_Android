# Copy this to .env for local development (never commit .env to git)
# Railway sets these automatically — you only need to set ALLOWED_ORIGINS manually

# Injected automatically by Railway's Postgres plugin:
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Comma-separated list of allowed frontend origins.
# Add your Vercel/Netlify URL and your Android app's origin here.
# For Android apps, add the wildcard or leave blank (Android doesn't send Origin headers).
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://your-frontend.netlify.app
